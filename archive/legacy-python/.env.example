SYNCGUARD_DATABASE_URL=postgresql://syncguard:syncguard@localhost:5432/syncguard
SYNCGUARD_ERP_PATH=./artifacts/erp.sqlite
SYNCGUARD_PM_URL=http://localhost:8002
SYNCGUARD_LEASE_SECONDS=10
SYNCGUARD_MAX_ATTEMPTS=5
SYNCGUARD_POLL_SECONDS=5
# Hard-exit fault hooks require both of these. Use only in a disposable worker process.
SYNCGUARD_ENABLE_FAULTS=false
SYNCGUARD_FAULT_POINT=
# Integration tests use a separate, disposable database.
SYNCGUARD_TEST_DATABASE_URL=
